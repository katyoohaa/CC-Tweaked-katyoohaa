local function clear()

    term.clear()
    term.setCursorPos(1, 1)

end


local function showItem(item)

    clear()

    local id = item.name or ""
    local namespace = getNamespace(id)

    local price, category, reason =
        evaluateItem(item)

    local total =
        price * item.count


    print("================================")
    print("        MARKET APPRAISER")
    print("================================")
    print()

    print("Item:")
    print(item.displayName or id)

    print()

    print("ID:")
    print(id)

    print()

    print("Mod:")
    print(namespace)

    print()

    print("Amount:")
    print(item.count)

    print()

    print("--------------------------------")
    print("VALUE")
    print("--------------------------------")
    print()

    print("1 item:")
    print(formatMoney(price))

    print()

    print("Total:")
    print(formatMoney(total))

    print()

    print("Category:")
    print(category)

    print()

    print("Reason:")
    print(reason)


    -- ========================================================
    -- DEBUG
    -- ========================================================

    if DEBUG then

        print()
        print("--------------------------------")
        print("DEBUG")
        print("--------------------------------")

        print("Enchant value:")
        print(getEnchantmentScore(item))

    end

end


-- ============================================================
-- GET FIRST ITEM FROM BARREL
-- ============================================================

local function getFirstItem()

    local items = inventory.list()

    for slot, data in pairs(items) do

        local detail =
            inventory.getItemDetail(slot)

        if detail then
            return detail
        end

    end

    return nil
end


-- ============================================================
-- MAIN LOOP
-- ============================================================

local lastID = nil

while true do

    local item = getFirstItem()


    if not item then

        if lastID ~= nil then
            clear()
        end

        print("================================")
        print("        MARKET APPRAISER")
        print("================================")
        print()
        print("Put an item into the barrel.")
        print()
        print("Waiting...")

        lastID = nil


    else

        local currentID =
            tostring(item.name)
            .. ":"
            .. tostring(item.nbt)
            .. ":"
            .. tostring(item.count)

        if currentID ~= lastID then

            showItem(item)

            lastID = currentID

        end

    end


    sleep(1)

end
