-- ============================================================
-- DETECT MOD TYPE
-- ============================================================

local function isModded(item)

    return getNamespace(item.name) ~= "minecraft"

end


-- ============================================================
-- DETECT ENCHANTMENTS
-- ============================================================

local function getEnchantmentScore(item)

    if not item.enchantments then
        return 0
    end

    local score = 0

    for _, enchantment in pairs(item.enchantments) do

        local level = enchantment.level or 1

        local name = string.lower(enchantment.name or "")

        local important = false

        for _, word in ipairs(importantEnchantments) do

            if contains(name, word) then
                important = true
                break
            end

        end

        if important then

            score = score + 20 + (level * 15)

        else

            score = score + 5 + (level * 5)

        end

    end

    return score
end


