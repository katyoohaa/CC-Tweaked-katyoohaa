-- ============================================================
-- CHECK WORD LIST
-- ============================================================

local function containsAny(text, words)

    for _, word in ipairs(words) do

        if contains(text, word) then
            return true
        end

    end

    return false
end


-- ============================================================
-- BASE VALUE
-- ============================================================

local function getBaseValue(item)

    local id = item.name or ""
    local name = getItemName(id)
    local namespace = getNamespace(id)

    -- ========================================================
    -- VANILLA EXACT VALUES
    -- ========================================================

    if namespace == "minecraft" then

        if VANILLA_RAW[name] ~= nil then
            return VANILLA_RAW[name]
        end

        if VANILLA_COMMON[name] ~= nil then
            return VANILLA_COMMON[name]
        end

        if VANILLA_PROCESSED[name] ~= nil then
            return VANILLA_PROCESSED[name]
        end
    end


    -- ========================================================
    -- SPECIAL MODS
    -- ========================================================

    local modMultiplier = MOD_MULTIPLIERS[namespace]


    -- ========================================================
    -- MODDED RAW MATERIAL
    --
    -- Still cheap, but more expensive than basic vanilla.
    -- ========================================================

    if namespace ~= "minecraft" then

        if containsAny(name, RAW_WORDS) then

            local value = 4

            if modMultiplier then
                value = math.floor(value * modMultiplier)
            end

            return math.max(value, MOD_MINIMUM)
        end

    end


    -- ========================================================
    -- PROCESSED ITEM
    -- ========================================================

    if containsAny(name, PROCESSED_WORDS) then

        local value = 12

        if modMultiplier then
            value = math.floor(value * modMultiplier)
        else
            value = math.floor(value * 1.5)
        end

        return math.max(value, 8)
    end


    -- ========================================================
    -- MACHINERY
    -- ========================================================

    if containsAny(name, MACHINE_WORDS) then

        local value = 64

        if modMultiplier then
            value = math.floor(value * modMultiplier)
        else
            value = value * 2
        end

        return value
    end


    -- ========================================================
    -- RARE / COLLECTIBLE ITEMS
    -- ========================================================

    if containsAny(name, RARE_WORDS) then

        local value = 64

        if modMultiplier then
            value = math.floor(value * modMultiplier)
        else
            value = value * 2
        end

        return math.max(value, 64)
    end


    -- ========================================================
    -- SPECIAL COSMETIC MODS
    -- ========================================================

    if namespace == "simplehats"
        or namespace == "simple_hats"
        or namespace == "selfexpression"
        or namespace == "self_expression" then

        return 256
    end


    -- ========================================================
    -- FOOD
    -- ========================================================

    if item.tags and item.tags["minecraft:food"] then

        if namespace == "minecraft" then
            return 1
        else
            return 4
        end
    end


    -- ========================================================
    -- WEAPONS / TOOLS
    -- ========================================================

    if contains(name, "sword")
        or contains(name, "axe")
        or contains(name, "pickaxe")
        or contains(name, "shovel")
        or contains(name, "hoe")
        or contains(name, "bow")
        or contains(name, "crossbow") then

        if namespace == "minecraft" then
            return 8
        else
            return 32
        end
    end


    -- ========================================================
    -- ARMOR
    -- ========================================================

    if contains(name, "helmet")
        or contains(name, "chestplate")
        or contains(name, "leggings")
        or contains(name, "boots") then

        if namespace == "minecraft" then
            return 12
        else
            return 48
        end
    end


    -- ========================================================
    -- UNKNOWN MOD ITEM
    --
    -- IMPORTANT:
    -- Never give an unknown mod item a vanilla price.
    -- ========================================================

    if namespace ~= "minecraft" then

        if modMultiplier then
            return math.floor(8 * modMultiplier)
        end

        return MOD_MINIMUM
    end


    -- ========================================================
    -- UNKNOWN VANILLA ITEM
    -- ========================================================

    return VANILLA_MINIMUM
end


-- ============================================================
-- COMPLEXITY
-- ============================================================

local function getComplexity(item)

    local id = item.name or ""
    local name = getItemName(id)
    local namespace = getNamespace(id)

    local score = 0


    -- Modded items automatically start above vanilla.
    if namespace ~= "minecraft" then
        score = score + 1
    end


    -- Create
    if namespace == "create" then
        score = score + 2
    end


    -- Mekanism
    if namespace == "mekanism" then
        score = score + 3
    end


    -- Refined Storage
    if namespace == "refinedstorage" then
        score = score + 2
    end


    -- Complex words
    if containsAny(name, PROCESSED_WORDS) then
        score = score + 2
    end


    if containsAny(name, MACHINE_WORDS) then
        score = score + 4
    end


    -- Rare items
    if containsAny(name, RARE_WORDS) then
        score = score + 4
    end


    -- Enchantments
    if item.enchantments then

        local count = #item.enchantments

        if count > 0 then
            score = score + count * 2
        end

    end


    return score
end


-- ============================================================
-- FINAL PRICE
-- ============================================================

local function calculatePrice(item)

    local base = getBaseValue(item)

    local complexity = getComplexity(item)

    local price = base


    -- Complexity bonus.
    if complexity >= 2 then
        price = price * 1.25
    end

    if complexity >= 4 then
        price = price * 1.5
    end

    if complexity >= 6 then
        price = price * 2
    end

    if complexity >= 8 then
        price = price * 3
    end


    -- Round down to an integer.
    price = math.floor(price)


    -- ========================================================
    -- PRICE FLOOR
    -- ========================================================

    local namespace = getNamespace(item.name)

    if namespace ~= "minecraft" then

        if price < MOD_MINIMUM then
            price = MOD_MINIMUM
        end

    else

        if price < VANILLA_MINIMUM then
            price = VANILLA_MINIMUM
        end

    end


    return price
end


-- ============================================================
-- DISPLAY
-- ============================================================

local function clear()

    term.clear()
    term.setCursorPos(1, 1)

end


local function showItem(item)

    clear()

    local id = item.name or ""
    local namespace = getNamespace(id)

    local price = calculatePrice(item)
    local total = price * item.count

    print("================================")
    print("        MARKET APPRAISER")
    print("================================")
    print()

    print("Item:")
    print(item.displayName or id)

    print()

    print("ID:")
    print(id)

    print()

    print("Mod:")
    print(namespace)

    print()

    print("Amount:")
    print(item.count)

    print()
    print("--------------------------------")
    print("ESTIMATED VALUE")
    print("--------------------------------")
    print()

    print("1 item:")
    print(formatMoney(price))

    print()

    print("Total:")
    print(formatMoney(total))

    print()

    print("--------------------------------")

    if namespace == "minecraft" then
        print("Category: VANILLA")
    else
        print("Category: MODDED")
    end


    if DEBUG then

        print()
        print("--------------------------------")
        print("DEBUG")
        print("--------------------------------")

        print("Base:")
        print(getBaseValue(item))

        print("Complexity:")
        print(getComplexity(item))

    end
end


-- ============================================================
-- GET FIRST ITEM
-- ============================================================

local function getFirstItem()

    local items = inventory.list()

    for slot, data in pairs(items) do

        local detail = inventory.getItemDetail(slot)

        if detail then
            return detail
        end

    end

    return nil
end


-- ============================================================
-- MAIN LOOP
-- ============================================================

local lastID = nil

while true do

    local item = getFirstItem()

    if not item then

        if lastID ~= nil then

            clear()
        end

        print("================================")
        print("        MARKET APPRAISER")
        print("================================")
        print()
        print("Put an item into the barrel.")
        print()
        print("Waiting...")

        lastID = nil

    else

        local id =
            tostring(item.name)
            .. ":"
            .. tostring(item.nbt)
            .. ":"
            .. tostring(item.count)

        if id ~= lastID then

            showItem(item)

            lastID = id

        end

    end

    sleep(1)

end
