        "magma_cream",
        "blaze_rod"
    }

    for _, drop in ipairs(drops) do

        if name == drop then
            return true
        end

    end

    return false
end


-- ============================================================
-- MAIN CATEGORY DETECTION
-- ============================================================

local function evaluateItem(item)

    local id = item.name or ""
    local name = getItemName(id)
    local namespace = getNamespace(id)

    local lowerName = string.lower(name)

    local price = PRICE_CHEAP
    local category = CATEGORY.CHEAP
    local reason = "Basic resource"


    -- ========================================================
    -- VANILLA
    -- ========================================================

    if namespace == "minecraft" then

        -- Cheap raw materials.
        if containsAny(lowerName, cheapMaterials) then

            price = PRICE_CHEAP
            category = CATEGORY.CHEAP
            reason = "Easy to obtain material"

        -- Cheap common resources.
        elseif containsAny(lowerName, cheapResources) then

            price = 2
            category = CATEGORY.CHEAP
            reason = "Common Minecraft resource"

        -- Basic crafting items.
        elseif containsAny(lowerName, basicCrafts) then

            price = 2
            category = CATEGORY.CHEAP
            reason = "Basic crafting component"

        -- Basic tools.
        elseif containsAny(lowerName, basicTools) then

            price = 4
            category = CATEGORY.CHEAP
            reason = "Unenchanted basic tool"

        -- Basic armor.
        elseif containsAny(lowerName, basicArmor) then

            price = PRICE_NORMAL
            category = CATEGORY.NORMAL
            reason = "Basic armor"

        -- Rare vanilla materials.
        elseif containsAny(lowerName, rareVanilla) then

            price = PRICE_MEDIUM
            category = CATEGORY.MEDIUM
            reason = "Rare Minecraft material"

        -- Vanilla food.
        elseif item.tags and item.tags["minecraft:food"] then

            price = PRICE_CHEAP
            category = CATEGORY.CHEAP
            reason = "Basic food"

        -- Common vanilla mob drops.
        elseif isCommonVanillaDrop(lowerName) then

            price = PRICE_CHEAP
            category = CATEGORY.CHEAP
            reason = "Common Minecraft mob drop"

        else

            price = PRICE_CHEAP
            category = CATEGORY.CHEAP
            reason = "Common Minecraft item"

        end


    -- ========================================================
    -- MODDED ITEMS
    -- ========================================================

    else

        -- ----------------------------------------------------
        -- ART
        -- ----------------------------------------------------

        if containsAny(lowerName, artWords) then

            price = PRICE_VERY_EXPENSIVE
            category = CATEGORY.VERY_EXPENSIVE
            reason = "Photography / modded art"


        -- ----------------------------------------------------
        -- CLOTHING / MOD ARMOR
        -- ----------------------------------------------------

        elseif containsAny(lowerName, modArmor) then

            price = PRICE_VERY_EXPENSIVE
            category = CATEGORY.VERY_EXPENSIVE
            reason = "Modded clothing / armor"


        -- ----------------------------------------------------
        -- HATS
        -- ----------------------------------------------------

        elseif containsAny(lowerName, hatWords) then

            price = PRICE_EXPENSIVE
            category = CATEGORY.EXPENSIVE
            reason = "Collectible hat"


        -- ----------------------------------------------------
        -- MECHANISMS
        -- ----------------------------------------------------

        elseif containsAny(lowerName, mechanisms) then

            price = PRICE_EXPENSIVE
            category = CATEGORY.EXPENSIVE
            reason = "Complex mechanism"


        -- ----------------------------------------------------
        -- MODDED WEAPONS
        -- ----------------------------------------------------

        elseif containsAny(lowerName, modWeapons) then

            price = PRICE_EXPENSIVE
            category = CATEGORY.EXPENSIVE
            reason = "Modded weapon"


        -- ----------------------------------------------------
        -- RARE MOB DROP
        -- ----------------------------------------------------

        elseif containsAny(lowerName, rareDropWords) then

            price = PRICE_EXPENSIVE
            category = CATEGORY.EXPENSIVE
            reason = "Rare modded mob drop"


        -- ----------------------------------------------------
        -- MODDED FOOD
        -- ----------------------------------------------------

        elseif containsAny(lowerName, modFoodWords)
            or (item.tags and item.tags["minecraft:food"]) then

            price = PRICE_MEDIUM
            category = CATEGORY.MEDIUM
            reason = "Prepared modded food"


        -- ----------------------------------------------------
        -- MODDED BASIC CRAFT
        -- ----------------------------------------------------

        elseif containsAny(lowerName, simpleModCrafts) then

            price = PRICE_NORMAL
            category = CATEGORY.NORMAL
            reason = "Simple modded crafting component"


        -- ----------------------------------------------------
        -- UNKNOWN MODDED ITEM
        -- ----------------------------------------------------

        else

            -- Unknown modded items are still more valuable
            -- than basic vanilla materials.

            price = PRICE_NORMAL
            category = CATEGORY.NORMAL
            reason = "Unknown modded item"

        end

    end


    -- ========================================================
    -- ENCHANTMENT BONUS
    -- ========================================================

    local enchantmentValue = getEnchantmentScore(item)

    if enchantmentValue > 0 then

        price = price + enchantmentValue

        if enchantmentValue >= 60 then

            category = CATEGORY.VERY_EXPENSIVE
            reason = "Strong enchantments"

        elseif enchantmentValue >= 30 then

            category = CATEGORY.EXPENSIVE
            reason = "Useful enchantments"

        else

            category = CATEGORY.MEDIUM
            reason = "Simple enchantments"

        end

    end


    -- ========================================================
    -- ENCHANTED BOOK
    -- ========================================================

    if contains(lowerName, "enchanted_book") then

        if enchantmentValue >= 60 then

            price = math.max(price, PRICE_VERY_EXPENSIVE)

        elseif enchantmentValue >= 30 then

            price = math.max(price, PRICE_EXPENSIVE)

        else

            price = math.max(price, PRICE_MEDIUM)

        end

    end


    -- ========================================================
    -- FINAL PRICE
    -- ========================================================

    price = math.floor(price)

    return price, category, reason
end


