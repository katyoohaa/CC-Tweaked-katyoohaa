-- ============================================================
-- CURRENCY FORMAT
-- ============================================================

local function formatMoney(value)

    if value <= 0 then
        return "FREE"
    end

    local sun = math.floor(value / 4096)
    value = value % 4096

    local crown = math.floor(value / 512)
    value = value % 512

    local cog = math.floor(value / 64)
    value = value % 64

    local sprocket = math.floor(value / 16)
    value = value % 16

    local bevel = math.floor(value / 8)
    local spur = value % 8

    local result = {}

    if sun > 0 then
        table.insert(result, sun .. " Sun")
    end

    if crown > 0 then
        table.insert(result, crown .. " Crown")
    end

    if cog > 0 then
        table.insert(result, cog .. " Cog")
    end

    if sprocket > 0 then
        table.insert(result, sprocket .. " Sprocket")
    end

    if bevel > 0 then
        table.insert(result, bevel .. " Bevel")
    end

    if spur > 0 then
        table.insert(result, spur .. " Spur")
    end

    return table.concat(result, " + ")
end


-- ============================================================
-- STRING HELPERS
-- ============================================================

local function contains(text, word)

    text = string.lower(text or "")
    word = string.lower(word)

    return string.find(text, word, 1, true) ~= nil
end


local function containsAny(text, words)

    for _, word in ipairs(words) do

        if contains(text, word) then
            return true
        end

    end

    return false
end


local function getNamespace(id)

    return string.match(id or "", "^([^:]+):") or "minecraft"
end


local function getItemName(id)

    return string.match(id or "", "^[^:]+:(.+)$") or id
end


