-- ============================================================

local DEBUG = true

-- Minimum price for an unknown MOD item.
-- Modded items should never be cheaper than basic vanilla items.
local MOD_MINIMUM = 4

-- Minimum price for an unknown VANILLA item.
local VANILLA_MINIMUM = 1


-- ============================================================
-- CURRENCY
-- ============================================================

local function formatMoney(value)

    if value <= 0 then
        return "FREE"
    end

    local sun = math.floor(value / 4096)
    value = value % 4096

    local crown = math.floor(value / 512)
    value = value % 512

    local cog = math.floor(value / 64)
    value = value % 64

    local sprocket = math.floor(value / 16)
    value = value % 16

    local bevel = math.floor(value / 8)
    local spur = value % 8

    local parts = {}

    if sun > 0 then
        table.insert(parts, sun .. " Sun")
    end

    if crown > 0 then
        table.insert(parts, crown .. " Crown")
    end

    if cog > 0 then
        table.insert(parts, cog .. " Cog")
    end

    if sprocket > 0 then
        table.insert(parts, sprocket .. " Sprocket")
    end

    if bevel > 0 then
        table.insert(parts, bevel .. " Bevel")
    end

    if spur > 0 then
        table.insert(parts, spur .. " Spur")
    end

    return table.concat(parts, " + ")
end


-- ============================================================
-- TEXT HELPERS
-- ============================================================

local function contains(text, value)

    return string.find(
        string.lower(text or ""),
        string.lower(value),
        1,
        true
    ) ~= nil

end


local function getNamespace(id)

    return string.match(id or "", "^([^:]+):") or "minecraft"

end


local function getItemName(id)

    return string.match(id or "", "^[^:]+:(.+)$") or id

end


