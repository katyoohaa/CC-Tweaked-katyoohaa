--========================================================
-- CLOTHING SHOP
-- CC:Tweaked + RS Bridge + Create Packager
--
-- LEFT   = сундук с одеждой
-- RIGHT  = сундук оплаты
-- BOTTOM = RS Bridge
-- BACK   = редстоун на Packager
--
-- ЦЕНЫ:
--
-- boots       = 64
-- leggings    = 128
-- helmet      = 128
-- chestplate  = 192
--
--========================================================


----------------------------------------------------------
-- НАСТРОЙКИ
----------------------------------------------------------

local ITEM_CHEST_SIDE = "left"
local PAYMENT_CHEST_SIDE = "right"
local RS_BRIDGE_SIDE = "bottom"

local PACKAGER_REDSTONE_SIDE = "back"

local CHECK_INTERVAL = 1
local PACKAGER_SIGNAL_TIME = 1
local PACKING_TIMEOUT = 30


----------------------------------------------------------
-- ПОДКЛЮЧЕНИЕ
----------------------------------------------------------

local itemChest = peripheral.wrap(ITEM_CHEST_SIDE)

if not itemChest then
    error("ERROR: Item chest not found on LEFT")
end


local paymentChest = peripheral.wrap(PAYMENT_CHEST_SIDE)

if not paymentChest then
    error("ERROR: Payment chest not found on RIGHT")
end


local rsBridge = peripheral.wrap(RS_BRIDGE_SIDE)

if not rsBridge then
    error("ERROR: RS Bridge not found on BOTTOM")
end


----------------------------------------------------------
-- ЭКРАН
----------------------------------------------------------

local function clearScreen()

    term.clear()
    term.setCursorPos(1, 1)

end


----------------------------------------------------------
-- ПОЛУЧЕНИЕ ЦЕНЫ ПО ID ПРЕДМЕТА
----------------------------------------------------------
--
-- Например:
--
-- selfexpression:snow_hunter_boots
--
-- заканчивается на:
--
-- boots
--
-- Поэтому цена = 64
--
----------------------------------------------------------

local function getPrice(item)

    if not item then
        return nil
    end


    local id = tostring(item.name or "")

    id = id:lower()


    ------------------------------------------------------
    -- ОБУВЬ
    ------------------------------------------------------

    if id:match("_boots$") then

        return 64

    end


    ------------------------------------------------------
    -- ШТАНЫ
    ------------------------------------------------------

    if id:match("_leggings$") then

        return 128

    end


    ------------------------------------------------------
    -- ШЛЯПА
    ------------------------------------------------------

    if id:match("_helmet$") then

        return 128

    end


    ------------------------------------------------------
    -- НАГРУДНИК
    ------------------------------------------------------

    if id:match("_chestplate$") then

        return 192

    end


    ------------------------------------------------------
    -- НЕИЗВЕСТНЫЙ ПРЕДМЕТ
    ------------------------------------------------------

    return nil

end


----------------------------------------------------------
-- ПОЛУЧЕНИЕ ОТОБРАЖАЕМОГО ИМЕНИ
----------------------------------------------------------

local function getItemName(item)

    if item.displayName then

        return tostring(item.displayName)

    end


    if item.label then

        return tostring(item.label)

    end


    return tostring(item.name or "Unknown item")

end


----------------------------------------------------------
-- СКАНИРОВАНИЕ СУНДУКА
----------------------------------------------------------

local function scanItems()

    local items = {}

    local total = 0

    local invalid = {}


    local list = itemChest.list()


    for slot, item in pairs(list) do

        local price = getPrice(item)

        local name = getItemName(item)


        local entry = {

            slot = slot,

            name = name,

            itemID = item.name,

            count = item.count,

            price = price

        }


        table.insert(items, entry)


        if price then

            total =
                total +
                price * item.count

        else

            table.insert(
                invalid,
                entry
            )

        end

    end


    return items, total, invalid

end


----------------------------------------------------------
-- ПРОВЕРКА ПУСТОГО СУНДУКА
----------------------------------------------------------

local function chestIsEmpty(chest)

    local list = chest.list()


    for _, _ in pairs(list) do

        return false

    end


    return true

end


----------------------------------------------------------
-- АЛМАЗЫ В СУНДУКЕ ОПЛАТЫ
----------------------------------------------------------

local function getPaymentChestDiamonds()

    local total = 0


    local list = paymentChest.list()


    for _, item in pairs(list) do

        if item.name == "minecraft:diamond" then

            total =
                total +
                item.count

        end

    end


    return total

end


----------------------------------------------------------
-- АЛМАЗЫ В RS
----------------------------------------------------------

local function getRSDiamonds()

    ------------------------------------------------------
    -- getItem(table)
    ------------------------------------------------------

    if rsBridge.getItem then

        local ok, result =
            pcall(
                function()

                    return rsBridge.getItem({
                        name = "minecraft:diamond"
                    })

                end
            )


        if ok and result ~= nil then

            if type(result) == "number" then

                return result

            end


            if type(result) == "table" then

                if result.amount then

                    return tonumber(result.amount) or 0

                end


                if result.count then

                    return tonumber(result.count) or 0

                end

            end

        end

    end


    ------------------------------------------------------
    -- getItem(string)
    ------------------------------------------------------

    if rsBridge.getItem then

        local ok, result =
            pcall(
                function()

                    return rsBridge.getItem(
                        "minecraft:diamond"
                    )

                end
            )


        if ok and result ~= nil then

            if type(result) == "number" then

                return result

            end


            if type(result) == "table" then

                if result.amount then

                    return tonumber(result.amount) or 0

                end


                if result.count then

                    return tonumber(result.count) or 0

                end

            end

        end

    end


    ------------------------------------------------------
    -- list()
    ------------------------------------------------------

    if rsBridge.list then

        local ok, result =
            pcall(
                function()

                    return rsBridge.list()

                end
            )


        if ok and type(result) == "table" then

            for _, item in pairs(result) do

                if item.name ==
                    "minecraft:diamond" then

                    return tonumber(
                        item.amount
                        or item.count
                        or 0
                    ) or 0

                end

            end

        end

    end


    return 0

end


----------------------------------------------------------
-- ПОКАЗ ТОВАРОВ
----------------------------------------------------------

local function displayItems(items)

    for _, item in ipairs(items) do

        print(item.name)

        print(
            "ID: " ..
            tostring(item.itemID)
        )

        print(
            "x" ..
            tostring(item.count) ..
            "  " ..
            tostring(item.price) ..
            "xx each"
        )

        print()

    end

end


----------------------------------------------------------
-- ОЖИДАНИЕ ОПЛАТЫ
----------------------------------------------------------

local function waitForPayment(
    required,
    initialRS
)

    while true do

        local currentRS =
            getRSDiamonds()


        local paid =
            currentRS - initialRS


        if paid < 0 then

            paid = 0

        end


        local chestDiamonds =
            getPaymentChestDiamonds()


        clearScreen()


        print("==============================")
        print("       CLOTHING SHOP")
        print("==============================")
        print()


        print(
            "TOTAL: " ..
            tostring(required) ..
            " diamonds"
        )


        print()


        print(
            "RECEIVED: " ..
            tostring(paid)
        )


        print()


        print(
            "PAYMENT CHEST: " ..
            tostring(chestDiamonds)
        )


        print()


        if paid >= required then

            print("==============================")
            print("       PAYMENT ACCEPTED")
            print("==============================")


            return paid

        end


        print(
            "REMAINING: " ..
            tostring(required - paid)
        )


        print()

        print(
            "Place diamonds into"
        )

        print(
            "the RIGHT chest."
        )


        sleep(CHECK_INTERVAL)

    end

end


----------------------------------------------------------
-- ЗАПУСК PACKAGER
----------------------------------------------------------

local function startPackager()

    clearScreen()


    print("==============================")
    print("       PAYMENT ACCEPTED")
    print("==============================")
    print()


    print("Starting Packager...")


    redstone.setOutput(
        PACKAGER_REDSTONE_SIDE,
        true
    )


    sleep(PACKAGER_SIGNAL_TIME)


    redstone.setOutput(
        PACKAGER_REDSTONE_SIDE,
        false
    )

end


----------------------------------------------------------
-- ОЖИДАНИЕ ОТПРАВКИ ВЕЩЕЙ
----------------------------------------------------------

local function waitForPacking()

    local elapsed = 0


    while elapsed < PACKING_TIMEOUT do

        if chestIsEmpty(itemChest) then

            return true

        end


        sleep(1)


        elapsed =
            elapsed + 1

    end


    return false

end


----------------------------------------------------------
-- ОШИБКА
----------------------------------------------------------

local function showInvalidItems(invalid)

    clearScreen()


    print("==============================")
    print("          ERROR")
    print("==============================")
    print()


    print("UNKNOWN CLOTHING:")

    print()


    for _, item in ipairs(invalid) do

        print(item.name)

        print()

        print(
            "ID: " ..
            tostring(item.itemID)
        )

        print()

        print(
            "The item does not end with:"
        )

        print(
            "_boots"
        )

        print(
            "_leggings"
        )

        print(
            "_helmet"
        )

        print(
            "_chestplate"
        )

        print()

    end

end


----------------------------------------------------------
-- СТАРТ
----------------------------------------------------------

clearScreen()


print("==============================")
print("       CLOTHING SHOP")
print("==============================")
print()


print("System starting...")


sleep(2)


----------------------------------------------------------
-- ГЛАВНЫЙ ЦИКЛ
----------------------------------------------------------

while true do


    ------------------------------------------------------
    -- СКАНИРУЕМ ОДЕЖДУ
    ------------------------------------------------------

    local items, total, invalid =
        scanItems()


    ------------------------------------------------------
    -- ПУСТО
    ------------------------------------------------------

    if #items == 0 then


        clearScreen()


        print("==============================")
        print("       CLOTHING SHOP")
        print("==============================")
        print()


        print("CART IS EMPTY")

        print()


        print(
            "Place clothing into"
        )

        print(
            "the LEFT chest."
        )


        sleep(CHECK_INTERVAL)


    ------------------------------------------------------
    -- НЕИЗВЕСТНАЯ ОДЕЖДА
    ------------------------------------------------------

    elseif #invalid > 0 then


        showInvalidItems(invalid)


        sleep(2)


    ------------------------------------------------------
    -- ЗАКАЗ ГОТОВ
    ------------------------------------------------------

    else


        --------------------------------------------------
        -- Запоминаем количество алмазов в RS
        --------------------------------------------------

        local initialRS =
            getRSDiamonds()


        --------------------------------------------------
        -- ПОКАЗЫВАЕМ ЗАКАЗ
        --------------------------------------------------

        clearScreen()


        print("==============================")
        print("       CLOTHING SHOP")
        print("==============================")
        print()


        print("YOUR ORDER:")

        print()


        displayItems(items)


        print("------------------------------")

        print()


        print(
            "TOTAL: " ..
            tostring(total) ..
            " diamonds"
        )


        print()


        print(
            "Put diamonds into"
        )

        print(
            "the RIGHT payment chest."
        )


        --------------------------------------------------
        -- ЖДЁМ ОПЛАТУ
        --------------------------------------------------

        local paid =
            waitForPayment(
                total,
                initialRS
            )


        --------------------------------------------------
        -- ПРОВЕРКА ПЕРЕПЛАТЫ
        --------------------------------------------------

        local change =
            paid - total


        clearScreen()


        print("==============================")
        print("       PAYMENT ACCEPTED")
        print("==============================")
        print()


        print(
            "PRICE: " ..
            tostring(total)
        )


        print(
            "PAID: " ..
            tostring(paid)
        )


        if change > 0 then

            print()

            print(
                "OVERPAYMENT: " ..
                tostring(change)
            )

            print()

            print(
                "Change is not returned"
            )

            print(
                "automatically yet."
            )

        end


        sleep(3)


        --------------------------------------------------
        -- ЗАПУСК PACKAGER
        --------------------------------------------------

        startPackager()


        --------------------------------------------------
        -- ЖДЁМ ОТПРАВКИ
        --------------------------------------------------

        clearScreen()


        print("==============================")
        print("       PACKING ORDER")
        print("==============================")
        print()


        print(
            "Sending clothes"
        )

        print(
            "to the Packager..."
        )


        local success =
            waitForPacking()


        --------------------------------------------------
        -- ГОТОВО
        --------------------------------------------------

        if success then


            clearScreen()


            print("==============================")
            print("       ORDER COMPLETE")
            print("==============================")
            print()


            print(
                "Your package is"
            )

            print(
                "on its way!"
            )


            print()

            print(
                "Thank you!"
            )


        --------------------------------------------------
        -- ОШИБКА PACKAGER
        --------------------------------------------------

        else


            clearScreen()


            print("==============================")
            print("      PACKAGING ERROR")
            print("==============================")
            print()


            print(
                "Clothes are still"
            )

            print(
                "in the item chest."
            )


            print()


            print(
                "Check the Packager,"
            )

            print(
                "belt and depot."
            )


        end


        sleep(5)

    end

end
