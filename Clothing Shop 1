--========================================================
-- CLOTHING SHOP
-- CC:Tweaked + RS Bridge + Create Packager
--
-- СХЕМА:
--
-- LEFT   = сундук с одеждой
-- RIGHT  = сундук оплаты
-- BOTTOM = RS Bridge
-- BACK   = редстоун на Packager
--
-- ОПЛАТА ПОКА: АЛМАЗЫ
--
-- ЦЕНА В ИМЕНИ:
--
--   Dress 64
--   Dress 64xx
--   Dress [64xx]
--
-- Все эти варианты = 64
--
--========================================================


----------------------------------------------------------
-- НАСТРОЙКИ
----------------------------------------------------------

local ITEM_CHEST_SIDE = "left"
local PAYMENT_CHEST_SIDE = "right"
local RS_BRIDGE_SIDE = "bottom"

-- Сторона, через которую компьютер включает Packager
local PACKAGER_REDSTONE_SIDE = "back"

-- Частота проверки
local CHECK_INTERVAL = 1

-- Сколько секунд держать сигнал Packager
local PACKAGER_SIGNAL_TIME = 1

-- Максимальное время ожидания отправки одежды
local PACKING_TIMEOUT = 30


----------------------------------------------------------
-- ПОДКЛЮЧЕНИЕ ПЕРИФЕРИЙ
----------------------------------------------------------

local itemChest = peripheral.wrap(ITEM_CHEST_SIDE)

if not itemChest then
    error("ERROR: Item chest not found on " .. ITEM_CHEST_SIDE)
end


local paymentChest = peripheral.wrap(PAYMENT_CHEST_SIDE)

if not paymentChest then
    error("ERROR: Payment chest not found on " .. PAYMENT_CHEST_SIDE)
end


local rsBridge = peripheral.wrap(RS_BRIDGE_SIDE)

if not rsBridge then
    error("ERROR: RS Bridge not found on " .. RS_BRIDGE_SIDE)
end


----------------------------------------------------------
-- ЭКРАН
----------------------------------------------------------

local function clearScreen()

    term.clear()
    term.setCursorPos(1, 1)

end


----------------------------------------------------------
-- ПОЛУЧЕНИЕ ИМЕНИ ПРЕДМЕТА
----------------------------------------------------------

local function getItemName(item)

    -- Основной вариант CC:Tweaked
    if item.displayName then
        return tostring(item.displayName)
    end

    -- Запасной вариант
    if item.label then
        return tostring(item.label)
    end

    -- Если переименованного имени нет
    if item.name then
        return tostring(item.name)
    end

    return "Unknown item"

end


----------------------------------------------------------
-- ПОЛУЧЕНИЕ ЦЕНЫ
--
-- Поддерживаются:
--
-- Dress 64
-- Dress 64xx
-- Dress [64xx]
-- Dress [64XX]
-- Dress 64XX
--
----------------------------------------------------------

local function getPrice(item)

    if not item then
        return nil
    end


    ------------------------------------------------------
    -- Получаем именно displayName
    ------------------------------------------------------

    local name = item.displayName


    ------------------------------------------------------
    -- Если displayName отсутствует, пробуем label
    ------------------------------------------------------

    if not name then
        name = item.label
    end


    ------------------------------------------------------
    -- Без отображаемого имени цену определить нельзя
    ------------------------------------------------------

    if not name then
        return nil
    end


    name = tostring(name)


    ------------------------------------------------------
    -- Убираем пробелы в начале и конце
    ------------------------------------------------------

    name = name:gsub("^%s+", "")
    name = name:gsub("%s+$", "")


    ------------------------------------------------------
    -- Вариант:
    --
    -- [64xx]
    ------------------------------------------------------

    local price = name:match("%[(%d+)%s*[xX][xX]%]")

    if price then
        return tonumber(price)
    end


    ------------------------------------------------------
    -- Вариант:
    --
    -- 64xx
    ------------------------------------------------------

    price = name:match("(%d+)%s*[xX][xX]")

    if price then
        return tonumber(price)
    end


    ------------------------------------------------------
    -- Вариант:
    --
    -- 64
    --
    -- Только число в конце имени.
    --
    -- Это позволяет избежать ситуации, когда число
    -- является частью обычного названия.
    ------------------------------------------------------

    price = name:match("(%d+)%s*$")

    if price then
        return tonumber(price)
    end


    return nil

end


----------------------------------------------------------
-- СКАНИРОВАНИЕ СУНДУКА С ОДЕЖДОЙ
----------------------------------------------------------

local function scanItems()

    local items = {}

    local total = 0

    local invalid = {}


    local list = itemChest.list()


    for slot, item in pairs(list) do

        local name = getItemName(item)

        local price = getPrice(item)


        local entry = {

            slot = slot,

            name = name,

            count = item.count,

            price = price,

            itemID = item.name

        }


        table.insert(items, entry)


        if price then

            total =
                total +
                (price * item.count)

        else

            table.insert(
                invalid,
                entry
            )

        end

    end


    return items, total, invalid

end


----------------------------------------------------------
-- ПРОВЕРКА ПУСТОГО СУНДУКА
----------------------------------------------------------

local function chestIsEmpty(chest)

    local list = chest.list()


    for _, _ in pairs(list) do

        return false

    end


    return true

end


----------------------------------------------------------
-- ПОЛУЧЕНИЕ АЛМАЗОВ В СУНДУКЕ ОПЛАТЫ
----------------------------------------------------------

local function getPaymentChestDiamonds()

    local total = 0


    local list = paymentChest.list()


    for _, item in pairs(list) do

        if item.name == "minecraft:diamond" then

            total =
                total +
                item.count

        end

    end


    return total

end


----------------------------------------------------------
-- ПОЛУЧЕНИЕ КОЛИЧЕСТВА АЛМАЗОВ В RS
--
-- Здесь специально используется несколько способов,
-- потому что API RS Bridge отличается между версиями.
----------------------------------------------------------

local function getRSDiamonds()

    ------------------------------------------------------
    -- Способ 1
    --
    -- getItem({
    --     name = "minecraft:diamond"
    -- })
    ------------------------------------------------------

    if rsBridge.getItem then

        local success, result =
            pcall(
                function()

                    return rsBridge.getItem({
                        name = "minecraft:diamond"
                    })

                end
            )


        if success and result ~= nil then

            if type(result) == "number" then

                return result

            end


            if type(result) == "table" then

                if result.amount then
                    return tonumber(result.amount) or 0
                end

                if result.count then
                    return tonumber(result.count) or 0
                end

            end

        end

    end


    ------------------------------------------------------
    -- Способ 2
    --
    -- getItem("minecraft:diamond")
    ------------------------------------------------------

    if rsBridge.getItem then

        local success, result =
            pcall(
                function()

                    return rsBridge.getItem(
                        "minecraft:diamond"
                    )

                end
            )


        if success and result ~= nil then

            if type(result) == "number" then

                return result

            end


            if type(result) == "table" then

                if result.amount then
                    return tonumber(result.amount) or 0
                end

                if result.count then
                    return tonumber(result.count) or 0
                end

            end

        end

    end


    ------------------------------------------------------
    -- Способ 3
    --
    -- list()
    ------------------------------------------------------

    if rsBridge.list then

        local success, result =
            pcall(
                function()

                    return rsBridge.list()

                end
            )


        if success and type(result) == "table" then

            for _, item in pairs(result) do

                if item.name == "minecraft:diamond" then

                    return
                        tonumber(
                            item.amount
                            or item.count
                            or 0
                        )
                        or 0

                end

            end

        end

    end


    ------------------------------------------------------
    -- Ничего не нашли
    ------------------------------------------------------

    return 0

end


----------------------------------------------------------
-- ПОКАЗ ТОВАРОВ
----------------------------------------------------------

local function showItems(items)

    for _, item in ipairs(items) do

        local priceText = "NO PRICE"


        if item.price then

            priceText =
                tostring(item.price) ..
                "xx"

        end


        print(item.name)

        print(
            "  x" ..
            tostring(item.count) ..
            "    " ..
            priceText
        )

        print()

    end

end


----------------------------------------------------------
-- ОЖИДАНИЕ ОПЛАТЫ
----------------------------------------------------------
--
-- initialRS = количество алмазов в RS ДО оплаты.
--
-- Если было:
--
-- 100
--
-- а стало:
--
-- 164
--
-- значит внесено:
--
-- 64
--
----------------------------------------------------------

local function waitForPayment(
    required,
    initialRS
)

    while true do

        local currentRS =
            getRSDiamonds()


        local paid =
            currentRS - initialRS


        --------------------------------------------------
        -- На случай если RS уменьшился
        --------------------------------------------------

        if paid < 0 then
            paid = 0
        end


        local paymentChest =
            getPaymentChestDiamonds()


        --------------------------------------------------
        -- ЭКРАН
        --------------------------------------------------

        clearScreen()


        print("==============================")
        print("       CLOTHING SHOP")
        print("==============================")
        print()


        print(
            "TOTAL: " ..
            tostring(required) ..
            " diamonds"
        )

        print()


        print(
            "RECEIVED: " ..
            tostring(paid) ..
            " diamonds"
        )

        print()


        print(
            "IN PAYMENT CHEST: " ..
            tostring(paymentChest)
        )

        print()


        local remaining =
            required - paid


        if remaining > 0 then

            print(
                "REMAINING: " ..
                tostring(remaining)
            )

        else

            print("PAYMENT ACCEPTED!")

            print()

            return paid

        end


        print()
        print("Please place diamonds")
        print("into the payment chest.")


        sleep(CHECK_INTERVAL)

    end

end


----------------------------------------------------------
-- ЗАПУСК PACKAGER
----------------------------------------------------------

local function startPackager()

    clearScreen()


    print("==============================")
    print("       PAYMENT ACCEPTED")
    print("==============================")
    print()

    print("Sending order to Packager...")
    print()


    ------------------------------------------------------
    -- Сигнал
    ------------------------------------------------------

    redstone.setOutput(
        PACKAGER_REDSTONE_SIDE,
        true
    )


    sleep(PACKAGER_SIGNAL_TIME)


    ------------------------------------------------------
    -- Выключаем сигнал
    ------------------------------------------------------

    redstone.setOutput(
        PACKAGER_REDSTONE_SIDE,
        false
    )

end


----------------------------------------------------------
-- ОЖИДАНИЕ ОТПРАВКИ ОДЕЖДЫ
----------------------------------------------------------

local function waitForPacking()

    local elapsed = 0


    while elapsed < PACKING_TIMEOUT do


        if chestIsEmpty(itemChest) then

            return true

        end


        sleep(1)


        elapsed =
            elapsed + 1

    end


    return false

end


----------------------------------------------------------
-- ПОКАЗ ОШИБКИ ЦЕНЫ
----------------------------------------------------------

local function showInvalidItems(invalid)

    clearScreen()


    print("==============================")
    print("           ERROR")
    print("==============================")
    print()


    print("PRICE NOT FOUND:")
    print()


    for _, item in ipairs(invalid) do

        print(item.name)

        print(
            "Amount: " ..
            tostring(item.count)
        )

        print()

    end


    print("------------------------------")
    print()


    print("Use price like:")
    print("[64xx]")
    print("or 64xx")
    print("or 64")


end


----------------------------------------------------------
-- ЗАПУСК
----------------------------------------------------------

clearScreen()


print("==============================")
print("       CLOTHING SHOP")
print("==============================")
print()


print("System starting...")


sleep(2)


----------------------------------------------------------
-- ОСНОВНОЙ ЦИКЛ
----------------------------------------------------------

while true do


    ------------------------------------------------------
    -- СКАНИРУЕМ СУНДУК
    ------------------------------------------------------

    local items, total, invalid =
        scanItems()


    ------------------------------------------------------
    -- ПУСТО
    ------------------------------------------------------

    if #items == 0 then


        clearScreen()


        print("==============================")
        print("       CLOTHING SHOP")
        print("==============================")
        print()


        print("CART IS EMPTY")

        print()

        print(
            "Place clothing into"
        )

        print(
            "the chest on the LEFT."
        )


        sleep(CHECK_INTERVAL)


    ------------------------------------------------------
    -- ЕСТЬ ПРЕДМЕТЫ БЕЗ ЦЕНЫ
    ------------------------------------------------------

    elseif #invalid > 0 then


        showInvalidItems(invalid)


        sleep(2)


    ------------------------------------------------------
    -- ЗАКАЗ КОРРЕКТНЫЙ
    ------------------------------------------------------

    else


        --------------------------------------------------
        -- Запоминаем количество алмазов ДО оплаты
        --------------------------------------------------

        local initialRS =
            getRSDiamonds()


        --------------------------------------------------
        -- Показываем заказ
        --------------------------------------------------

        clearScreen()


        print("==============================")
        print("       CLOTHING SHOP")
        print("==============================")
        print()


        print("YOUR ORDER:")

        print()


        showItems(items)


        print("------------------------------")


        print()


        print(
            "TOTAL: " ..
            tostring(total) ..
            " diamonds"
        )


        print()


        print(
            "Put diamonds into"
        )

        print(
            "the PAYMENT CHEST."
        )


        --------------------------------------------------
        -- ЖДЁМ ОПЛАТУ
        --------------------------------------------------

        local paid =
            waitForPayment(
                total,
                initialRS
            )


        --------------------------------------------------
        -- ПРОВЕРКА ПЕРЕПЛАТЫ
        --------------------------------------------------

        local change =
            paid - total


        clearScreen()


        print("==============================")
        print("       PAYMENT ACCEPTED")
        print("==============================")
        print()


        print(
            "PRICE: " ..
            tostring(total)
        )


        print(
            "PAID: " ..
            tostring(paid)
        )


        if change > 0 then

            print(
                "CHANGE: " ..
                tostring(change)
            )

            print()

            print(
                "IMPORTANT:"
            )

            print(
                "Extra diamonds are not"
            )

            print(
                "returned automatically yet."
            )

        end


        print()


        sleep(3)


        --------------------------------------------------
        -- ЗАПУСК PACKAGER
        --------------------------------------------------

        startPackager()


        --------------------------------------------------
        -- ЖДЁМ ПОКА ОДЕЖДА УЕДЕТ
        --------------------------------------------------

        clearScreen()


        print("==============================")
        print("       PACKING ORDER")
        print("==============================")
        print()


        print(
            "Your clothes are being"
        )

        print(
            "sent to the Packager."
        )

        print()


        local success =
            waitForPacking()


        --------------------------------------------------
        -- УСПЕШНО
        --------------------------------------------------

        if success then


            clearScreen()


            print("==============================")
            print("       ORDER COMPLETE")
            print("==============================")
            print()


            print(
                "Your package is"
            )

            print(
                "on its way!"
            )


            print()

            print(
                "Thank you!"
            )


        --------------------------------------------------
        -- НЕ УСПЕЛИ ОТПРАВИТЬ
        --------------------------------------------------

        else


            clearScreen()


            print("==============================")
            print("      PACKAGING ERROR")
            print("==============================")
            print()


            print(
                "The clothing chest"
            )

            print(
                "was not emptied."
            )


            print()


            print(
                "Check the Packager,"
            )

            print(
                "belt and depot."
            )


        end


        --------------------------------------------------
        -- Пауза перед следующим заказом
        --------------------------------------------------

        sleep(5)

    end

end
